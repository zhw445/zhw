from flask import Blueprint, request, jsonify
from flask_jwt_extended import create_access_token
from ..extensions import db
from ..models import User

auth_bp = Blueprint("auth", __name__)


@auth_bp.post("/register")
def register():
    """
    注册用户
    ---
    tags: [认证]
    parameters:
      - in: body
        name: body
        required: true
        schema:
          properties:
            username: {type: string}
            password: {type: string}
            role:     {type: string, enum: [admin, teacher, student]}
            real_name:{type: string}
    responses:
      201: {description: 注册成功}
      400: {description: 用户名已存在}
    """
    d = request.get_json() or {}
    if not d.get("username") or not d.get("password"):
        return jsonify(msg="用户名和密码不能为空"), 400
    if User.query.filter_by(username=d["username"]).first():
        return jsonify(msg="用户名已存在"), 400

    u = User(username=d["username"],
             role=d.get("role", "student"),
             real_name=d.get("real_name", ""))
    u.set_password(d["password"])
    db.session.add(u)
    db.session.commit()
    return jsonify(msg="注册成功", id=u.id), 201


@auth_bp.post("/login")
def login():
    """
    用户登录
    ---
    tags: [认证]
    parameters:
      - in: body
        name: body
        required: true
        schema:
          properties:
            username: {type: string}
            password: {type: string}
    responses:
      200:
        description: 返回 access_token
        schema:
          properties:
            access_token: {type: string}
            role: {type: string}
            name: {type: string}
      401: {description: 用户名或密码错误}
    """
    d = request.get_json() or {}
    u = User.query.filter_by(username=d.get("username")).first()
    if not u or not u.check_password(d.get("password", "")):
        return jsonify(msg="用户名或密码错误"), 401

    token = create_access_token(
        identity=str(u.id),
        additional_claims={"role": u.role}
    )
    return jsonify(access_token=token, role=u.role, name=u.real_name)

