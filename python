from flask import Blueprint, request, jsonify
from ..extensions import db
from ..models import Student, Grade, Major
from ..decorators import role_required
from ..cache import cache_get_or_set, invalidate, invalidate_pattern

student_bp = Blueprint("student", __name__)


@student_bp.get("/<int:sid>")
@role_required("admin", "teacher", "student")
def get_student(sid):
    """
    查询单个学生（缓存穿透保护：空值也缓存）
    ---
    tags: [学生]
    security:
      - Bearer: []
    parameters:
      - in: path
        name: sid
        type: integer
        required: true
    responses:
      200: {description: 学生信息}
      404: {description: 学生不存在}
    """
    key = f"student:{sid}"
    data = cache_get_or_set(key,
                            loader=lambda: (db.session.get(Student, sid) or
                                            type("X", (), {"to_dict": lambda: None})()).to_dict(),
                            ttl=300)
    if data is None:
        return jsonify(msg="学生不存在"), 404
    return jsonify(data)


@student_bp.get("")
@role_required("admin", "teacher")
def list_students():
    """
    多条件组合检索（列表缓存）
    ---
    tags: [学生]
    security:
      - Bearer: []
    parameters:
      - {in: query, name: name,   type: string,  description: 姓名（模糊）}
      - {in: query, name: sno,    type: string,  description: 学号（模糊）}
      - {in: query, name: gender, type: string,  enum: [M, F]}
      - {in: query, name: grade,  type: string,  description: 年级名称}
      - {in: query, name: major,  type: string,  description: 专业名称}
      - {in: query, name: page,   type: integer, default: 1}
      - {in: query, name: size,   type: integer, default: 20}
    responses:
      200:
        description: 分页结果
        schema:
          properties:
            total: {type: integer}
            items: {type: array}
    """
    name   = request.args.get("name", "").strip()
    sno    = request.args.get("sno", "").strip()
    gender = request.args.get("gender", "").strip()
    grade  = request.args.get("grade", "").strip()
    major  = request.args.get("major", "").strip()
    page   = max(1, int(request.args.get("page", 1)))
    size   = min(100, max(1, int(request.args.get("size", 20))))

    key = f"students:list:{name}|{sno}|{gender}|{grade}|{major}|{page}|{size}"

    def loader():
        q = Student.query
        if name:   q = q.filter(Student.name.like(f"%{name}%"))
        if sno:    q = q.filter(Student.sno.like(f"%{sno}%"))
        if gender: q = q.filter(Student.gender == gender)
        if grade:  q = q.join(Grade).filter(Grade.name == grade)
        if major:  q = q.join(Major).filter(Major.name == major)

        total = q.count()
        rows = (q.order_by(Student.id.desc())
                 .offset((page - 1) * size)
                 .limit(size).all())
        return {"total": total, "items": [r.to_dict() for r in rows]}

    return jsonify(cache_get_or_set(key, loader, ttl=120))


