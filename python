@student_bp.put("/<int:sid>")
@role_required("admin", "teacher")
def update_student(sid):
    """
    更新学生信息
    ---
    tags: [学生]
    security:
      - Bearer: []
    parameters:
      - {in: path, name: sid, type: integer, required: true}
      - in: body
        name: body
        schema:
          properties:
            name: {type: string}
            gender: {type: string}
            age: {type: integer}
            grade_id: {type: integer}
            major_id: {type: integer}
    responses:
      200: {description: 更新成功}
      404: {description: 学生不存在}
    """
    s = db.session.get(Student, sid)
    if not s:
        return jsonify(msg="学生不存在"), 404

    d = request.get_json() or {}
    for field in ("name", "gender", "age", "grade_id", "major_id"):
        if field in d:
            setattr(s, field, d[field])
    db.session.commit()

    invalidate(f"student:{sid}")
    invalidate_pattern("students:list:*")
    return jsonify(s.to_dict())


@student_bp.delete("/<int:sid>")
@role_required("admin")
def delete_student(sid):
    """
    删除学生（仅管理员）
    ---
    tags: [学生]
    security:
      - Bearer: []
    parameters:
      - {in: path, name: sid, type: integer, required: true}
    responses:
      200: {description: 删除成功}
      404: {description: 学生不存在}
    """
    s = db.session.get(Student, sid)
    if not s:
        return jsonify(msg="学生不存在"), 404
    db.session.delete(s)
    db.session.commit()

    invalidate(f"student:{sid}")
    invalidate_pattern("students:list:*")
    return jsonify(msg="删除成功")

