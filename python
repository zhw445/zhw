    """数据看板：ZSET 排行榜 + 成绩分布 + Excel 导出"""
from io import BytesIO
from flask import Blueprint, jsonify, send_file
from sqlalchemy import func
from openpyxl import Workbook

from ..extensions import db, redis_client
from ..models import Student, Grade, Major, Score
from ..decorators import role_required

dashboard_bp = Blueprint("dashboard", __name__)

RANK_GRADE = "rank:grade"
RANK_MAJOR = "rank:major"
RANK_TTL   = 600   # ZSET 10 分钟过期


def _refresh_rank():
    """用 ZSET 重建年级/专业人数排行榜（避免频繁 COUNT + GROUP BY）"""
    pipe = redis_client.pipeline()
    pipe.delete(RANK_GRADE, RANK_MAJOR)

    grade_rows = (db.session.query(Grade.name, func.count(Student.id))
                  .join(Student, Student.grade_id == Grade.id)
                  .group_by(Grade.name).all())
    for name, cnt in grade_rows:
        pipe.zadd(RANK_GRADE, {name: cnt})

    major_rows = (db.session.query(Major.name, func.count(Student.id))
                  .join(Student, Student.major_id == Major.id)
                  .group_by(Major.name).all())
    for name, cnt in major_rows:
        pipe.zadd(RANK_MAJOR, {name: cnt})

    pipe.expire(RANK_GRADE, RANK_TTL)
    pipe.expire(RANK_MAJOR, RANK_TTL)
    pipe.execute()


def get_rank(key, top=10):
    """读取排行榜；若已过期或为空则自动重建"""
    if redis_client.zcard(key) == 0:
        _refresh_rank()
    data = redis_client.zrevrange(key, 0, top - 1, withscores=True)
    return [{"name": n, "count": int(c)} for n, c in data]


@dashboard_bp.get("/rank/grade")
@role_required("admin", "teacher")
def rank_grade():
    """
    年级人数排行榜 TOP10
    ---
    tags: [看板]
    security:
      - Bearer: []
    responses:
      200:
        description: 年级排行
        schema:
          type: array
          items:
            properties:
              name: {type: string}
              count: {type: integer}
    """
    return jsonify(get_rank(RANK_GRADE))


@dashboard_bp.get("/rank/major")
@role_required("admin", "teacher")
def rank_major():
    """
    专业人数排行榜 TOP10
    ---
    tags: [看板]
    security:
      - Bearer: []
    responses:
      200: {description: 专业排行}
    """
    return jsonify(get_rank(RANK_MAJOR))


@dashboard_bp.get("/score-distribution")
@role_required("admin", "teacher")
def score_distribution():
    """
    成绩分段分布（ECharts 饼图数据源）
    ---
    tags: [看板]
    security:
      - Bearer: []
    responses:
      200:
        description: 分数区间统计
        schema:
          type: array
          items:
            properties:
              range: {type: string}
              count: {type: integer}
    """
    buckets = {"0-59": 0, "60-69": 0, "70-79": 0, "80-89": 0, "90-100": 0}
    for (s,) in db.session.query(Score.score).all():
        if s < 60:    buckets["0-59"] += 1
        elif s < 70:  buckets["60-69"] += 1
        elif s < 80:  buckets["70-79"] += 1
        elif s < 90:  buckets["80-89"] += 1
        else:         buckets["90-100"] += 1
    return jsonify([{"range": k, "count": v} for k, v in buckets.items()])


@dashboard_bp.get("/export")
@role_required("admin", "teacher")
def export_excel():
    """
    导出全部学生信息为 Excel
    ---
    tags: [看板]
    security:
      - Bearer: []
    produces:
      - application/vnd.openxmlformats-officedocument.spreadsheetml.sheet
    responses:
      200: {description: Excel 文件}
    """
    wb = Workbook()
    ws = wb.active
    ws.title = "学生信息"
    ws.append(["ID", "学号", "姓名", "性别", "年龄", "年级", "专业"])

    for s in Student.query.all():
        ws.append([s.id, s.sno, s.name, s.gender, s.age,
                   s.grade.name if s.grade else "",
                   s.major.name if s.major else ""])

    bio = BytesIO()
    wb.save(bio)
    bio.seek(0)
    return send_file(
        bio,
        as_attachment=True,
        download_name="students.xlsx",
        mimetype="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
    )

