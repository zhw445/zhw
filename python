    """角色权限装饰器"""
from functools import wraps
from flask import jsonify
from flask_jwt_extended import verify_jwt_in_request, get_jwt


def role_required(*roles):
    """
    用法：
        @role_required("admin", "teacher")
        def xxx(): ...
    校验 JWT 中的 role 字段是否在允许列表内。
    """
    def wrapper(fn):
        @wraps(fn)
        def inner(*args, **kwargs):
            verify_jwt_in_request()
            claims = get_jwt()
            if claims.get("role") not in roles:
                return jsonify(msg="无权限访问"), 403
            return fn(*args, **kwargs)
        return inner
    return wrapper

    app/cache.py
    """
缓存工具：一次性解决缓存穿透、击穿、雪崩
- 穿透：查不到时缓存 "__NULL__"（短 TTL 60s）
- 击穿：用 SETNX 互斥锁，只有一个请求回源
- 雪崩：TTL 加随机偏移 ± 60s
"""
import json
import random
import time
import app.extensions as ext


def _rand_ttl(base=300, jitter=60):
    """生成带随机偏移的 TTL，避免同一时刻集体失效"""
    return base + random.randint(-jitter, jitter)


def cache_get_or_set(key, loader, ttl=300, jitter=60):
    """
    通用缓存读取入口
    :param key:    缓存键
    :param loader: 回源函数，返回可序列化对象或 None
    :param ttl:    基础 TTL
    :param jitter: 随机偏移
    """
    r = ext.redis_client

    # ---------- 1. 命中缓存 ----------
    val = r.get(key)
    if val is not None:
        return None if val == "__NULL__" else json.loads(val)

    # ---------- 2. 尝试获取互斥锁（防击穿） ----------
    lock_key = f"lock:{key}"
    got_lock = r.set(lock_key, "1", nx=True, ex=5)   # 5 秒自动释放
    if not got_lock:
        # 未抢到锁：短暂等待后直接再读一次
        time.sleep(0.05)
        val = r.get(key)
        if val is not None:
            return None if val == "__NULL__" else json.loads(val)
        # 若还读不到，直接回源（兜底，避免死等）
        return loader()

    # ---------- 3. 持有锁：回源写入 ----------
    try:
        data = loader()
        if data is None:
            # 防穿透：空值也缓存，但 TTL 短
            r.set(key, "__NULL__", ex=60)
            return None
        r.set(key,
              json.dumps(data, ensure_ascii=False, default=str),
              ex=_rand_ttl(ttl, jitter))
        return data
    finally:
        r.delete(lock_key)


def invalidate(*keys):
    """删除一个或多个 key"""
    r = ext.redis_client
    if keys:
        r.delete(*keys)


def invalidate_pattern(pattern):
    """按模式批量删除（如 students:list:*），使用 SCAN 避免阻塞"""
    r = ext.redis_client
    keys = list(r.scan_iter(match=pattern, count=500))
    if keys:
        r.delete(*keys)

