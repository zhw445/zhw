from datetime import datetime
from werkzeug.security import generate_password_hash, check_password_hash
from .extensions import db


class User(db.Model):
    """用户表（admin / teacher / student）"""
    __tablename__ = "users"
    id         = db.Column(db.Integer, primary_key=True)
    username   = db.Column(db.String(64), unique=True, nullable=False, index=True)
    password   = db.Column(db.String(255), nullable=False)
    role       = db.Column(db.Enum("admin", "teacher", "student"),
                           default="student", index=True)
    real_name  = db.Column(db.String(64))
    created_at = db.Column(db.DateTime, default=datetime.utcnow)

    student = db.relationship("Student", backref="user", uselist=False)

    def set_password(self, pwd):
        self.password = generate_password_hash(pwd)

    def check_password(self, pwd):
        return check_password_hash(self.password, pwd)


class Grade(db.Model):
    """年级表"""
    __tablename__ = "grades"
    id   = db.Column(db.Integer, primary_key=True)
    name = db.Column(db.String(32), unique=True, nullable=False)
    students = db.relationship("Student", backref="grade")


class Major(db.Model):
    """专业表"""
    __tablename__ = "majors"
    id   = db.Column(db.Integer, primary_key=True)
    name = db.Column(db.String(64), unique=True, nullable=False)
    students = db.relationship("Student", backref="major")


class Student(db.Model):
    """学生信息表（主要业务表）"""
    __tablename__ = "students"
    id         = db.Column(db.Integer, primary_key=True)
    sno        = db.Column(db.String(20), unique=True, nullable=False, index=True)
    name       = db.Column(db.String(64), nullable=False, index=True)
    gender     = db.Column(db.Enum("M", "F"), default="M")
    age        = db.Column(db.Integer)
    grade_id   = db.Column(db.Integer, db.ForeignKey("grades.id"), index=True)
    major_id   = db.Column(db.Integer, db.ForeignKey("majors.id"), index=True)
    user_id    = db.Column(db.Integer, db.ForeignKey("users.id"))
    created_at = db.Column(db.DateTime, default=datetime.utcnow, index=True)

    scores = db.relationship("Score", backref="student",
                             cascade="all, delete-orphan")

    def to_dict(self):
        return {
            "id": self.id, "sno": self.sno, "name": self.name,
            "gender": self.gender, "age": self.age,
            "grade": self.grade.name if self.grade else None,
            "major": self.major.name if self.major else None,
        }


class Course(db.Model):
    """课程表"""
    __tablename__ = "courses"
    id         = db.Column(db.Integer, primary_key=True)
    name       = db.Column(db.String(64), nullable=False)
    credit     = db.Column(db.Float, default=1.0)
    teacher_id = db.Column(db.Integer, db.ForeignKey("users.id"))


class Score(db.Model):
    """成绩表"""
    __tablename__ = "scores"
    id         = db.Column(db.Integer, primary_key=True)
    student_id = db.Column(db.Integer, db.ForeignKey("students.id"), index=True)
    course_id  = db.Column(db.Integer, db.ForeignKey("courses.id"), index=True)
    score      = db.Column(db.Float, nullable=False)
    created_at = db.Column(db.DateTime, default=datetime.utcnow)

    course = db.relationship("Course")

