from flask import Blueprint, request, jsonify
from ..extensions import db
from ..models import Score
from ..decorators import role_required

teacher_bp = Blueprint("teacher", __name__)


@teacher_bp.post("/score")
@role_required("admin", "teacher")
def set_score():
    """
    录入/更新成绩
    ---
    tags: [教师]
    security:
      - Bearer: []
    parameters:
      - in: body
        name: body
        required: true
        schema:
          properties:
            student_id: {type: integer}
            course_id: {type: integer}
            score: {type: number}
    responses:
      200: {description: 录入成功}
    """
    d = request.get_json() or {}
    if not all(k in d for k in ("student_id", "course_id", "score")):
        return jsonify(msg="参数不完整"), 400

    s = Score.query.filter_by(student_id=d["student_id"],
                              course_id=d["course_id"]).first()
    if s:
        s.score = d["score"]
    else:
        s = Score(student_id=d["student_id"],
                  course_id=d["course_id"],
                  score=d["score"])
        db.session.add(s)
    db.session.commit()
    return jsonify(msg="ok", id=s.id)

