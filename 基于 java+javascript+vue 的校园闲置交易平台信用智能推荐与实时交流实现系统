import SockJS from 'sockjs-client'
import { Client } from '@stomp/stompjs'
import { useChatStore } from '@/stores/chat'

let client = null

export function connectWS(token) {
  const chatStore = useChatStore()
  client = new Client({
    webSocketFactory: () => new SockJS('/ws?token=' + token),
    reconnectDelay: 5000,
    onConnect: () => {
      client.subscribe('/user/queue/messages', (frame) => {
        const msg = JSON.parse(frame.body)
        chatStore.receiveMessage(msg)
        ElNotification({ title: '新消息', message: msg.content })
      })
      client.subscribe('/user/queue/notify', (frame) => {
        const notify = JSON.parse(frame.body)
        ElNotification({ title: '通知', message: notify.content })
      })
    }
  })
  client.activate()
}

export function sendMessage(toId, content, msgType = 0) {
  client.publish({
    destination: '/app/chat.send',
    body: JSON.stringify({ toId, content, msgType })
  })
}

export function disconnectWS() { client?.deactivate() }
