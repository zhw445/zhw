@Service
public class CreditServiceImpl {

    /** 信用分基线：100 分，范围 0-150 */
    private static final int BASE_SCORE = 100;

    /**
     * 信用分 = 基础分 + 交易完成率*20 + 平均评分因子*20
     *          + 活跃度*10 - 违约/纠纷扣分
     */
    public int calculateCredit(Long userId) {
        UserStat stat = orderMapper.selectUserStat(userId);
        double finishRate = stat.getTotalOrders() == 0 ? 1.0
                : (double) stat.getFinishedOrders() / stat.getTotalOrders();
        double avgScore = reviewMapper.selectAvgScore(userId);      // 1~5
        double activeScore = Math.min(stat.getLast30dOrders() / 5.0, 1.0);

        double score = BASE_SCORE
                + finishRate * 20
                + (avgScore - 3) * 10          // 3星为中性
                + activeScore * 10
                - stat.getDisputeCount() * 5
                - stat.getCancelCount() * 2;

        return (int) Math.max(0, Math.min(150, Math.round(score)));
    }

    /** 信用变更 + 流水 */
    @Transactional
    public void changeCredit(Long userId, int delta, String reason, Long refId) {
        userMapper.updateCredit(userId, delta);
        creditLogMapper.insert(new CreditLog(userId, delta, reason, refId));
        // 信用分变化 → 删除缓存
        redisTemplate.delete("user:credit:" + userId);
        // 同步 ZSet 排行榜
        redisTemplate.opsForZSet().add("rank:credit", userId.toString(),
                userMapper.selectById(userId).getCreditScore());
    }

    /** 缓存的信用查询（防穿透/击穿/雪崩） */
    public int getCreditWithCache(Long userId) {
        String key = "user:credit:" + userId;
        Object cached = redisTemplate.opsForValue().get(key);
        if (cached != null) return (int) cached;

        // 互斥锁防击穿
        String lockKey = "lock:credit:" + userId;
        Boolean locked = redisTemplate.opsForValue()
                .setIfAbsent(lockKey, "1", 3, TimeUnit.SECONDS);

        if (Boolean.TRUE.equals(locked)) {
            try {
                User user = userMapper.selectById(userId);
                int score = user == null ? -1 : user.getCreditScore();
                // 空值短 TTL 防穿透 + 随机偏移防雪崩
                long ttl = user == null ? 60
                        : 300 + ThreadLocalRandom.current().nextInt(-60, 61);
                redisTemplate.opsForValue().set(key, score, ttl, TimeUnit.SECONDS);
                return score;
            } finally {
                redisTemplate.delete(lockKey);
            }
        } else {
            // 未抢到锁：短暂休眠后重试
            try { Thread.sleep(50); } catch (InterruptedException ignored) {}
            return getCreditWithCache(userId);
        }
    }
}
@Service
public class RecommendServiceImpl {

    /**
     * 推荐打分 = 0.4*信用匹配 + 0.3*类目兴趣 + 0.2*价格适配 + 0.1*热度
     */
    public List<GoodsVO> recommendForUser(Long userId, int page, int size) {
        String cacheKey = "rec:user:" + userId + ":" + page;
        List<GoodsVO> cached = (List<GoodsVO>) redisTemplate.opsForValue().get(cacheKey);
        if (cached != null) return cached;

        // 1. 用户画像：近30天浏览/收藏的类目分布
        Map<Integer, Double> interest = buildInterestProfile(userId);
        User user = userMapper.selectById(userId);
        int myCredit = user.getCreditScore();

        // 2. 候选集：在售商品（限制500条避免全表扫描）
        List<Goods> candidates = goodsMapper.selectOnSaleLimit(500);

        // 3. 打分
        List<ScoredGoods> scored = candidates.stream().map(g -> {
            int sellerCredit = getCreditWithCache(g.getSellerId());
            double creditMatch = 1 - Math.abs(myCredit - sellerCredit) / 150.0;
            double categoryMatch = interest.getOrDefault(g.getCategoryId(), 0.0);
            double priceFit = priceFitScore(userId, g.getPrice());
            double hotness = Math.min(g.getViewCount() / 100.0, 1.0);

            double score = 0.4 * creditMatch + 0.3 * categoryMatch
                         + 0.2 * priceFit + 0.1 * hotness;
            return new ScoredGoods(g, score);
        }).sorted(Comparator.comparingDouble(ScoredGoods::getScore).reversed())
          .limit(200)
          .map(ScoredGoods::toVO)
          .collect(Collectors.toList());

        // 分页切片 + 缓存（随机 TTL 防雪崩）
        List<GoodsVO> result = paginate(scored, page, size);
        redisTemplate.opsForValue().set(cacheKey, result,
                180 + ThreadLocalRandom.current().nextInt(60), TimeUnit.SECONDS);
        return result;
    }

    /** 用 Redis ZSet 记录用户对类目的兴趣权重 */
    private Map<Integer, Double> buildInterestProfile(Long userId) {
        Set<ZSetOperations.TypedTuple<String>> tuples = redisTemplate.opsForZSet()
                .reverseRangeWithScores("user:interest:" + userId, 0, 9);
        if (tuples == null || tuples.isEmpty()) return Collections.emptyMap();
        double max = tuples.stream().mapToDouble(ZSetOperations.TypedTuple::getScore).max().orElse(1);
        return tuples.stream().collect(Collectors.toMap(
                t -> Integer.parseInt(t.getValue()),
                t -> t.getScore() / max));
    }

    /** 用户浏览/收藏时打点 */
    public void onUserAction(Long userId, int categoryId, double weight) {
        redisTemplate.opsForZSet().incrementScore(
                "user:interest:" + userId, String.valueOf(categoryId), weight);
        redisTemplate.expire("user:interest:" + userId, 30, TimeUnit.DAYS);
        // 清推荐缓存
        redisTemplate.delete(redisTemplate.keys("rec:user:" + userId + ":*"));
    }
}
@Configuration
@EnableWebSocketMessageBroker
public class WebSocketConfig implements WebSocketMessageBrokerConfigurer {

    @Override
    public void registerStompEndpoints(StompEndpointRegistry registry) {
        registry.addEndpoint("/ws")
                .setAllowedOriginPatterns("*")
                .withSockJS();
    }

    @Override
    public void configureMessageBroker(MessageBrokerRegistry registry) {
        registry.enableSimpleBroker("/queue", "/topic");
        registry.setUserDestinationPrefix("/user");
        registry.setApplicationDestinationPrefixes("/app");
    }
}

@Controller    //WebSocket 实时聊天
public class ChatController {

    @Autowired private SimpMessagingTemplate messagingTemplate;
    @Autowired private ChatMessageMapper chatMapper;
    @Autowired private CreditService creditService;

    /** 客户端发送到 /app/chat.send → 推送给对方 /user/{id}/queue/messages */
    @MessageMapping("/chat.send")
    public void send(@Payload ChatMessage msg, Principal principal) {
        Long fromId = Long.parseLong(principal.getName());
        msg.setFromId(fromId);
        msg.setCreatedAt(LocalDateTime.now());
        chatMapper.insert(msg);

        // 推送给接收者（在线即收，离线存库）
        messagingTemplate.convertAndSendToUser(
                msg.getToId().toString(), "/queue/messages", msg);
        // 回执给发送者（确认送达）
        messagingTemplate.convertAndSendToUser(
                fromId.toString(), "/queue/ack", msg.getId());
    }

    /** 商品详情页 → 一键聊卖家，带商品卡片上下文 */
    @MessageMapping("/chat.goods")
    public void chatAboutGoods(@Payload GoodsCardMsg msg, Principal principal) {
        Long fromId = Long.parseLong(principal.getName());
        Goods goods = goodsMapper.selectById(msg.getGoodsId());
        // 交易意向建立 → 提升类目兴趣权重
        recommendService.onUserAction(fromId, goods.getCategoryId(), 1.5);
        // 通知卖家有新的商品咨询
        messagingTemplate.convertAndSendToUser(
                goods.getSellerId().toString(), "/queue/notify",
                new NotifyVO("GOODS_INQUIRY", "有人咨询你的商品：" + goods.getTitle()));
    }
}
@Transactional
public void finishOrder(Long orderId, Long operatorId) {
    Order order = orderMapper.selectById(orderId);
    order.setStatus(2);
    order.setFinishedAt(LocalDateTime.now());
    orderMapper.updateById(order);

    // 双方信用分 +3（按时完成）
    creditService.changeCredit(order.getBuyerId(), 3, "交易完成", orderId);
    creditService.changeCredit(order.getSellerId(), 3, "交易完成", orderId);

    // 更新 Redis ZSet 交易榜
    redisTemplate.opsForZSet().incrementScore(
            "rank:trader", order.getSellerId().toString(), 1);

    // WebSocket 推送双方
    messagingTemplate.convertAndSendToUser(
            order.getBuyerId().toString(), "/queue/notify",
            new NotifyVO("ORDER_DONE", "订单已完成，请评价对方"));
}
